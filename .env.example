# =============================================================
# TalantHub — muhit o'zgaruvchilari (.env.example)
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring.
# Docker'da bitta .env hamma servisga env_file orqali beriladi.
# =============================================================

# --- Telegram --------------------------------------------------
# @BotFather'dan olingan token
BOT_TOKEN=123456:AAABBBCCCDDDEEEFFFGGGHHHIIIJJJKKK

# Tasdiqlangan e'lonlar chiqadigan kanal: @kanal_username yoki -100... (private kanal)
# Bot shu kanalda ADMIN bo'lishi (xabar yuborish huquqi bilan) shart.
CHANNEL_ID=@talanthub_channel

# Moderatorlarning Telegram ID'lari (vergul bilan). Yangi e'lonlar shularga
# tasdiqlash/rad etish tugmalari bilan yuboriladi. Har biri botga /start bosgan bo'lsin.
# O'z ID'ingizni @userinfobot orqali bilib olishingiz mumkin.
ADMIN_IDS=123456789

# --- Bot <-> Backend --------------------------------------------
# Docker'da: servis nomi (docker-compose'dagi nom bilan bir xil bo'lsin: web-admin)
# Lokal (docker'siz): http://localhost:8000/api
BACKEND_API_URL=http://web-admin:8000/api

# Bot va backend uchun BIR XIL bo'lishi shart. Yaratish:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=change-me-internal-key

# --- Backend / Django -------------------------------------------
DJANGO_SECRET_KEY=change-me-django-secret-key
DEBUG=False
ALLOWED_HOSTS=*
TIME_ZONE=Asia/Tashkent
# Admin panelga boshqa IP/domen orqali kirilsa (vergul bilan), masalan: http://192.168.1.7:8000
CSRF_TRUSTED_ORIGINS=

# Docker'da host = db. Lokal (docker'siz) ishlatsangiz: @localhost:5432
DATABASE_URL=postgres://postgres:123456@db:5432/talanthub

# db konteyneri uchun (DATABASE_URL bilan mos bo'lsin)
POSTGRES_DB=talanthub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456

# Tasdiqlangan e'londan keyin qayta e'lon joylash uchun kutish (soat)
ANNOUNCEMENT_COOLDOWN_HOURS=24

# --- Superuser (entrypoint.sh birinchi ishga tushishda avtomatik yaratadi) ---
# Django admin va React admin panelga kirish uchun shu login/parol ishlatiladi
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@talanthub.uz
DJANGO_SUPERUSER_PASSWORD=ChangeMe-Strong-Password-123
